# ---------- Server ----------
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=store_rating

# Separate database used by `npm test` (it is wiped and re-seeded on every run)
DB_NAME_TEST=store_rating_test

# ---------- Auth ----------
# Use a long random string in production, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
