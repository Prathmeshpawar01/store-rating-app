{
  "name": "store-rating-backend",
  "version": "1.0.0",
  "description": "REST API for the Store Rating application (Express + MySQL + JWT)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "db:seed": "node src/scripts/seed.js",
    "db:setup": "node src/scripts/initDb.js && node src/scripts/seed.js",
    "test": "node --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
